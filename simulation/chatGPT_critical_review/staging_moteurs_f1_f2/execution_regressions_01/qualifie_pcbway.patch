 BASE = RACINE / "resultats" / "pcbway_r1"
+MOTEUR_F1 = "fdtd"
+MOTEUR_F2 = "maillage_controle_v2"
+SOURCE_F2 = "fdtd_maille_controlee.py"
+
+
+def identite_moteur(manifeste, qualification):
+    """Deux tags absents designent F1 ; seul le double tag F2 est accepte."""
+    if "moteur" not in manifeste and "moteur" not in qualification:
+        return MOTEUR_F1
+    if manifeste.get("moteur") == qualification.get("moteur") == MOTEUR_F2:
+        return MOTEUR_F2
+    raise ValueError("tags moteur du manifeste et de la qualification incompatibles")
+
+
+def module_moteur(moteur=None):
+    """Registre ferme : aucun nom de module fourni par une archive n'est importe."""
+    if moteur is None or moteur == MOTEUR_F1:
+        return F
+    if moteur != MOTEUR_F2:
+        raise ValueError("moteur de simulation inconnu")
+    import importlib
+    module = importlib.import_module("fdtd_maille_controlee")
+    if (getattr(module, "NOM_MOTEUR", None) != MOTEUR_F2 or
+            Path(module.__file__).resolve() != (RACINE / SOURCE_F2).resolve()):
+        raise ValueError("module du moteur F2 different du module connu")
+    return module
+
+
+def moteur_calcul(dossier, manifeste, qualification, exiger_courant=False):
+    """Controle le marqueur et l'inventaire complet avant choix du moteur."""
+    nom = identite_moteur(manifeste, qualification)
+    inventaire = manifeste.get("sources_sha256")
+    if not isinstance(inventaire, dict):
+        raise ValueError("inventaire des sources du moteur absent")
+    source_f2 = Path(dossier) / "sources" / SOURCE_F2
+    if nom == MOTEUR_F1 and (SOURCE_F2 in inventaire or source_f2.exists()):
+        raise ValueError("source F2 presente sans les deux tags moteur F2")
+    if nom == MOTEUR_F2 and (SOURCE_F2 not in inventaire or not source_f2.is_file()):
+        raise ValueError("source du moteur F2 absente")
+    module = module_moteur(nom)
+    attendues = module._sources()
+    if nom == MOTEUR_F2:
+        complet = dict(F._sources())
+        complet[SOURCE_F2] = hashlib.sha256(Path(module.__file__).read_bytes()).hexdigest()
+        if attendues != complet:
+            raise ValueError("le moteur F2 doit conserver les neuf sources F1 et sa propre source")
+    if set(inventaire) != set(attendues):
+        raise ValueError("inventaire complet des sources du moteur different")
+    if (exiger_courant or nom == MOTEUR_F2) and inventaire != attendues:
+        raise ValueError("sources physiques/moteur modifiees depuis le calcul")
+    return module
 
 
